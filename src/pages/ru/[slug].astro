---
import LocalizedCorePage from '../../components/LocalizedCorePage.astro'; import { localizedCorePages } from '../../data/localizedCorePages';
export function getStaticPaths(){return localizedCorePages.ru.filter(p=>p.slug!=='home').map(page=>({params:{slug:page.slug},props:{page}}));} const {page}=Astro.props;
---
<LocalizedCorePage lang="ru" page={page} />
