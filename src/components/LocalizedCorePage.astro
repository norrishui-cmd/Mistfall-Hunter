---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedFaqModule from './RelatedFaqModule.astro';
import TabNewsModule from './TabNewsModule.astro';
import { localizedCorePages, localizedCorePath, type LocalizedCorePage } from '../data/localizedCorePages';

interface Props {
  lang: import('../i18n').Lang;
  page: LocalizedCorePage;
}

const { lang, page } = Astro.props as Props;
const site = Astro.site ?? new URL('https://mistfallhunter.me');
const path = page.slug === 'home' ? '/' : `/${page.slug}`;
const labelsByLang = {
  de:{verified:'Geprüfte Grundlagen',sources:'Offizielle Quellen',related:'Weitere deutsche Guides',open:'Öffnen',updated:'Aktualisiert: 25. Juli 2026',home:'Start'},
  ja:{verified:'確認済みの基本情報',sources:'公式情報源',related:'関連する日本語攻略',open:'開く',updated:'更新日：2026年7月25日',home:'ホーム'},
  'zh-hant':{verified:'已核實的基本資訊',sources:'官方來源',related:'相關繁體中文攻略',open:'查看',updated:'更新：2026年7月25日',home:'首頁'},
  es:{verified:'Información verificada',sources:'Fuentes oficiales',related:'Más guías en español',open:'Abrir',updated:'Actualizado: 25 de julio de 2026',home:'Inicio'},
  ru:{verified:'Проверенные сведения',sources:'Официальные источники',related:'Другие русские гайды',open:'Открыть',updated:'Обновлено: 25 июля 2026',home:'Главная'},
  ko:{verified:'검증된 기본 정보',sources:'공식 출처',related:'관련 한국어 가이드',open:'열기',updated:'업데이트: 2026년 7월 25일',home:'홈'},
  fr:{verified:'Informations vérifiées',sources:'Sources officielles',related:'Autres guides en français',open:'Ouvrir',updated:'Mis à jour : 25 juillet 2026',home:'Accueil'},
  'pt-br':{verified:'Informações verificadas',sources:'Fontes oficiais',related:'Mais guias em português',open:'Abrir',updated:'Atualizado: 25 de julho de 2026',home:'Início'},
} as const;
const labels = labelsByLang[lang as keyof typeof labelsByLang];
const allPages = localizedCorePages[lang];
const related = allPages.filter((item) => item.slug !== page.slug).slice(0, 4);
const sourceUrls = [
  'https://store.steampowered.com/app/3282300/Mistfall_Hunter/',
  'https://www.xbox.com/en-US/games/store/mistfall-hunter/9p8x6tvw9zw8',
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': page.slug === 'home' ? 'WebPage' : 'Article',
  headline: page.h1,
  description: page.description,
  inLanguage: lang,
  dateModified: '2026-07-25',
  mainEntityOfPage: new URL(localizedCorePath(lang, page.slug), site).href,
  author: { '@type': 'Organization', name: 'Mistfall Hunter Wiki and Hub' },
  publisher: { '@type': 'Organization', name: 'Mistfall Hunter Wiki and Hub' },
  citation: sourceUrls,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: page.slug === 'home' ? [
    { '@type': 'ListItem', position: 1, name: page.h1, item: new URL(localizedCorePath(lang, 'home'), site).href },
  ] : [
    { '@type': 'ListItem', position: 1, name: labels.home, item: new URL(localizedCorePath(lang, 'home'), site).href },
    { '@type': 'ListItem', position: 2, name: page.h1, item: new URL(localizedCorePath(lang, page.slug), site).href },
  ],
};
const faqCluster = page.slug === 'release-date' ? 'release'
  : page.slug === 'builds' || page.slug === 'classes' || page.slug === 'weapons' ? 'builds'
  : page.slug === 'about' || page.slug === 'sources' ? 'about'
  : page.slug === 'updates' || page.slug.includes('issue') || page.slug.includes('patch') ? 'news'
  : page.slug === 'game-data' || page.slug === 'loot' || page.slug === 'bosses' ? 'gameData'
  : 'guides';
const deepening = {
  de: {
    classes:{title:'Klasse vor dem ersten Run prüfen',intro:'Wähle nicht nur nach vermutetem Schaden. Prüfe, ob die Klasse deinen häufigsten Fehler abfedert und zur Gruppengröße passt.',items:['Solo: eigener Rückzug oder sichere Reichweite','Trio: klarer Nutzen neben reinem Schaden','Waffenhaltung vor Affixen festlegen','Nach Balance-Patches erneut bewerten']},
    builds:{title:'Build in drei Runs testen',intro:'Ein Build ist erst brauchbar, wenn er unter echtem Extraktionsdruck funktioniert. Ändere pro Test nur eine Variable.',items:['Run 1: Überleben und Ressourcenverbrauch','Run 2: Zeit bis zum sicheren Kill','Run 3: Rückzug mit wertvoller Beute','Patchdatum und geänderte Affixe notieren']},
    guides:{title:'Empfohlene Lernreihenfolge',intro:'Arbeite vom Überleben zur Optimierung. So verlierst du weniger Ausrüstung, während du Karte und Matchups lernst.',items:['Ausgang und Soul of Return verstehen','Eine Klasse und beide Waffenhaltungen lernen','Erst danach Boss- und High-Loot-Routen','Builds nur mit aktuellem Patchstand übernehmen']},
    performance:{title:'Fehler sauber eingrenzen',intro:'Ändere nicht gleichzeitig Treiber, Grafik und Netzwerk. Ein kontrollierter Test zeigt, ob Client, Server oder Plattform die Ursache ist.',items:['Offiziellen Serverstatus prüfen','Fehlertext und Zeitpunkt notieren','Spieldateien prüfen und einmal neu starten','Grafikoptionen einzeln testen']},
  },
  ja: {
    classes:{title:'初回出撃前のクラス確認',intro:'想定火力だけで選ばず、自分が起こしやすい失敗を補えるか、人数構成に合うかを確認します。',items:['ソロ：自力離脱または安全な射程','3人：火力以外の明確な役割','Affixより先に武器スタンスを決める','調整パッチ後に再評価する']},
    builds:{title:'3回の出撃でビルドを検証',intro:'実際の脱出圧力で機能して初めて実用ビルドです。1回の検証で変える要素は1つにします。',items:['1回目：生存力と消耗品使用量','2回目：安全な撃破までの時間','3回目：高価値戦利品を持つ撤退','パッチ日と変更Affixを記録']},
    guides:{title:'おすすめ学習順序',intro:'生還から最適化へ進むと、装備損失を抑えながらマップと相性を覚えられます。',items:['出口とSoul of Returnを理解','1クラスと両武器スタンスを習得','次にBossと高価値ルート','現行パッチ対応ビルドだけ参照']},
    performance:{title:'原因を一つずつ切り分ける',intro:'ドライバー、画質、ネットワークを同時に変えないでください。段階的な検証でクライアント、サーバー、プラットフォームを判別します。',items:['公式サーバー状態を確認','エラー文と発生時刻を記録','ファイル検証後に一度再起動','画質設定を一項目ずつ試す']},
  },
} as const;
const deepBlock = (lang === 'de' || lang === 'ja') ? deepening[lang][page.slug as keyof typeof deepening.de] : undefined;
---

<BaseLayout lang={lang} path={path} title={page.title} description={page.description} jsonLd={[articleSchema, breadcrumbSchema]}>
  <section class="section">
    <div class="container">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1 class="page-title">{page.h1}</h1>
      <p class="lead">{page.lead}</p>

      <aside class="quality-panel" aria-label={labels.verified}>
        <span class="eyebrow">{labels.verified}</span>
        <p>{labels.updated}</p>
        <p class="quality-sources">
          <strong>{labels.sources}:</strong>{' '}
          <a href={sourceUrls[0]} rel="noopener noreferrer">Steam</a>{' / '}
          <a href={sourceUrls[1]} rel="noopener noreferrer">Xbox</a>
        </p>
      </aside>

      <div class="prose">
        {page.sections.map((section) => (
          <Fragment>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
          </Fragment>
        ))}
      </div>
      {deepBlock && <aside class="quality-panel action-panel">
        <h2>{deepBlock.title}</h2>
        <p>{deepBlock.intro}</p>
        <ol>{deepBlock.items.map((item) => <li>{item}</li>)}</ol>
      </aside>}
      {(lang === 'de' || lang === 'ja') && <RelatedFaqModule cluster={faqCluster} lang={lang} />}
      {(lang === 'de' || lang === 'ja') && <TabNewsModule cluster={faqCluster === 'gameData' ? 'guides' : faqCluster === 'news' ? 'about' : faqCluster} lang={lang} />}
    </div>
  </section>

  <section class="section related-section">
    <div class="container">
      <h2 class="section-title">{labels.related}</h2>
      <div class="cards related-cards">
        {related.map((item) => (
          <a class="card" href={localizedCorePath(lang, item.slug)}>
            <span class="card-title">{item.h1}</span>
            <span class="card-desc">{item.description}</span>
            <span class="card-arrow">{labels.open} -&gt;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
