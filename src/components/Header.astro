---
import { languages, localizePath, languagesForPath, useTranslations, type Lang } from '../i18n';
import { isIndexableHref } from '../data/seoPages';
import SearchModal from './SearchModal.astro';

interface Props {
  lang: Lang;
  path: string;
}

type NavItem = {
  labelKey: string;
  path: string;
};

const { lang, path } = Astro.props as Props;
const t = useTranslations(lang);

const items: NavItem[] = [
  { labelKey: 'nav.home', path: '/' },
  { labelKey: 'nav.release', path: '/release-date' },
  { labelKey: 'nav.guides', path: '/guides' },
  ...(lang === 'en' || lang === 'zh' ? [{ labelKey: 'nav.maps', path: '/map' }] : []),
  ...(lang === 'en' || lang === 'zh' ? [{ labelKey: 'nav.bosses', path: '/bosses' }] : []),
  { labelKey: 'nav.builds', path: '/builds' },
  ...(lang === 'en' || lang === 'zh' || lang === 'de' || lang === 'ja' ? [{ labelKey: 'nav.data', path: '/game-data' }] : []),
  ...(lang === 'en' || lang === 'zh' || lang === 'de' || lang === 'ja' ? [{ labelKey: 'nav.faq', path: '/faq' }] : []),
  ...(lang === 'de' || lang === 'ja' ? [{ labelKey: 'nav.news', path: '/news' }] : []),
  { labelKey: 'nav.about', path: '/about' },
];

const languageOptions = languagesForPath(path);
const languageLabel = ({zh:'选择语言',de:'Sprache wählen',ja:'言語を選択','zh-hant':'選擇語言',es:'Elegir idioma',ru:'Выбрать язык',ko:'언어 선택',fr:'Choisir la langue','pt-br':'Escolher idioma'} as Partial<Record<Lang,string>>)[lang] ?? 'Choose language';
const siteName = t('site.name');
const siteTagline = t('site.tagline');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localizePath('/', lang)}>
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>
        <span class="brand-name">{siteName}</span>
        <span class="brand-tag">{siteTagline}</span>
      </span>
    </a>

    <div class="header-right">
      <nav class="nav" aria-label="Primary">
        {items.map((item) => (
          <a
            href={localizePath(item.path, lang)}
            aria-current={item.path === path ? 'page' : undefined}
          >
            {t(item.labelKey)}
          </a>
        ))}
      </nav>

      <SearchModal lang={lang} />

      <div class="language-select">
        <label for="lang-switch" class="sr-only">{languageLabel}</label>
        <select
          id="lang-switch"
          aria-label={languageLabel}
          onchange="if(this.value) window.location.href=this.value;"
        >
          {languageOptions.map((option) => {
            const targetHref = localizePath(path, option);
            return (
              <option value={targetHref} selected={option === lang}>
                {languages[option]}
              </option>
            );
          })}
        </select>
        <noscript>
          <nav class="language-tabs" aria-label={languageLabel}>
            {languageOptions.map((option) => {
              const targetHref = localizePath(path, option);
              const targetIsDraft = !isIndexableHref(targetHref);
              return (
                <a
                  class="language-tab"
                  href={targetHref}
                  hreflang={option === 'zh' ? 'zh-Hans' : option === 'zh-hant' ? 'zh-Hant' : option === 'es' ? 'es-ES' : option === 'pt-br' ? 'pt-BR' : option}
                  lang={option === 'zh' ? 'zh-Hans' : option === 'zh-hant' ? 'zh-Hant' : option}
                  aria-current={option === lang ? 'true' : undefined}
                  rel={targetIsDraft ? 'nofollow' : undefined}
                >
                  {languages[option]}
                </a>
              );
            })}
          </nav>
        </noscript>
      </div>
    </div>
  </div>
</header>
