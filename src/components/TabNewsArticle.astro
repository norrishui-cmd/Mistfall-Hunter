---
import BaseLayout from '../layouts/BaseLayout.astro';
import TabNewsModule from './TabNewsModule.astro';
import RelatedFaqModule from './RelatedFaqModule.astro';
import { newsClusters, tabNewsSources, type TabNewsItem } from '../data/tabNews';
import { getDeepNewsLocale } from '../data/tabNewsDeepLocales';
interface Props { item: TabNewsItem; lang: 'en' | 'zh' | 'de' | 'ja' }
const { item, lang } = Astro.props as Props;
const zh = lang === 'zh';
const copy = lang === 'de' || lang === 'ja' ? getDeepNewsLocale(item.slug,item.cluster,lang) : zh ? item.zh : item.en;
const cluster = newsClusters[item.cluster];
// Maps and Bosses only have a hub page (/map, /bosses) in en/zh — the nav
// item itself is gated to those two locales. For de/ja, which do have a
// /news system but not those hub pages, falling back to /news avoids a
// dead "back to hub" link instead of localizing a page that doesn't exist.
const clusterHrefSupportedInLang = lang === 'en' || lang === 'zh' || (item.cluster !== 'maps' && item.cluster !== 'bosses');
const backHref = clusterHrefSupportedInLang ? cluster.href : '/news';
const source = tabNewsSources[item.source];
const prefix = lang === 'en' ? '' : `/${lang}`;
const path = `/news/${item.slug}`;
const url = `https://mistfallhunter.me${prefix}${path}/`;
const labels = lang === 'de'
  ? {home:'Start',news:'News',updated:'Aktualisiert',source:'Offizielle Quelle: ',answer:'Kurzantwort',details:'Bestätigte Details',why:'Warum das wichtig ist',watch:'Was noch zu prüfen ist',verify:'Quelle und Prüfung',verifyText:'Nur aktuell sichtbare Angaben offizieller Stores gelten als bestätigt. Regionale Stores, Versionen und Patches können Details ändern.',original:'Offizielle Originalseite öffnen',back:'Zurück zum Themenbereich'}
  : lang === 'ja'
  ? {home:'ホーム',news:'ニュース',updated:'更新',source:'公式情報源：',answer:'要点',details:'確認済み情報',why:'重要な理由',watch:'今後の確認事項',verify:'出典と検証',verifyText:'現在確認できる公式ストア情報だけを確定事項として扱います。地域、エディション、パッチで内容が変わる場合があります。',original:'公式ページを開く',back:'関連トピックへ戻る'}
  : null;
const schema = {'@context':'https://schema.org','@type':'NewsArticle',headline:copy.title,description:copy.description,url,datePublished:item.date,dateModified:'2026-07-26',inLanguage:lang,isAccessibleForFree:true,author:{'@type':'Organization',name:'Mistfall Hunter Wiki and Hub'},publisher:{'@type':'Organization',name:'Mistfall Hunter Wiki and Hub'},citation:[source.url],mainEntityOfPage:url};
const breadcrumb = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:labels?.home ?? (zh?'首页':'Home'),item:`https://mistfallhunter.me${prefix}/`},
  {'@type':'ListItem',position:2,name:labels?.news ?? (zh?'新闻':'News'),item:`https://mistfallhunter.me${prefix}/news/`},
  {'@type':'ListItem',position:3,name:copy.title,item:url},
]};
---
<BaseLayout lang={lang} path={path} title={copy.title} description={copy.description} jsonLd={[schema,breadcrumb]}>
  <article class="section news-article"><div class="container">
    <nav class="breadcrumbs"><a href={`${prefix}/`}>{labels?.home ?? (zh?'首页':'Home')}</a><span>›</span><a href={`${prefix}/news`}>{labels?.news ?? (zh?'新闻':'News')}</a><span>›</span><span>{copy.title}</span></nav>
    <span class="eyebrow">{copy.title}</span><h1 class="page-title">{copy.title}</h1><p class="lead">{copy.description}</p>
    <div class="news-meta"><time datetime={item.date}>{labels?.updated ?? (zh?'更新于':'Updated')} {item.date}</time><span>·</span><a href={source.url} rel="noopener noreferrer">{labels?.source ?? (zh?'官方来源：':'Official source: ')}{source.name}</a></div>
    <div class="answer-box"><span class="eyebrow">{labels?.answer ?? (zh?'直接结论':'Direct answer')}</span><p>{copy.answer}</p></div>
    <div class="prose">
      <h2>{labels?.details ?? (zh?'已确认信息':'What is confirmed')}</h2><p>{copy.answer}</p><ul>{copy.details.map((detail)=><li>{detail}</li>)}</ul>
      <h2>{labels?.why ?? (zh?'为什么值得关注':'Why this matters')}</h2><p>{copy.why}</p>
      <h2>{labels?.watch ?? (zh?'接下来需要关注什么':'What to watch next')}</h2><p>{copy.watch}</p>
      <h2>{labels?.verify ?? (zh?'来源与核实原则':'Source and verification')}</h2><p>{labels?.verifyText ?? (zh?'本文只把官方商店当前可见内容写成已确认事实。':'This update treats only currently visible official-store information as confirmed.')}</p>
      <p><a href={source.url} rel="noopener noreferrer">{labels?.original ?? (zh?'查看官方原始页面':'Open the original official listing')}</a> · <a href={`${prefix}${backHref}`}>{labels?.back ?? (zh?'返回所属 Tab':'Return to topic hub')}</a></p>
    </div>
    <TabNewsModule cluster={item.cluster} lang={lang} /><RelatedFaqModule cluster="news" lang={lang} />
  </div></article>
</BaseLayout>
<style>.breadcrumbs,.news-meta{display:flex;flex-wrap:wrap;gap:.55rem;color:var(--ash);margin-bottom:2rem}.news-meta{margin:1rem 0 2rem;font-size:.85rem}.answer-box{background:var(--stone);border-left:4px solid var(--gylden);padding:1.2rem 1.4rem;margin:2rem 0}.answer-box p{font-size:1.15rem;margin:.55rem 0 0}.news-article .prose{max-width:48rem}</style>
