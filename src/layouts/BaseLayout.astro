---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  path?: string;
  image?: string;
  jsonLd?: object[];
  noindex?: boolean;
  preloadImage?: string;
}

const { title, description, lang, path = '/', image, jsonLd, noindex, preloadImage } = Astro.props;
const htmlLang: Record<Lang,string> = { en:'en', zh:'zh-Hans', de:'de', ja:'ja', 'zh-hant':'zh-Hant', es:'es-ES', ru:'ru', ko:'ko', fr:'fr', 'pt-br':'pt-BR' };
const skipLabel = ({zh:'跳到正文',de:'Zum Inhalt',ja:'本文へ移動','zh-hant':'跳到正文',es:'Ir al contenido',ru:'К содержанию',ko:'본문으로 이동',fr:'Aller au contenu','pt-br':'Ir para o conteúdo'} as Partial<Record<Lang,string>>)[lang] ?? 'Skip to content';
---

<!doctype html>
<html lang={htmlLang[lang]} data-pagefind-ignore={noindex ? 'all' : undefined}>
  <head>
    <BaseHead
      title={title}
      description={description}
      lang={lang}
      path={path}
      image={image}
      jsonLd={jsonLd}
      noindex={noindex}
      preloadImage={preloadImage}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <Header lang={lang} path={path} />
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
